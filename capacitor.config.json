{
  "appId": "com.servicehub.serviceos",
  "appName": "ServiceOS",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "url": "http://localhost:8080",
    "cleartext": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#090d16"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
